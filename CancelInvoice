 public function cancelInvoice(Request $request)
{
    $request->validate([
        'invoice_identifier' => 'required|string',
        'cn_motif'           => 'required|string',
    ]);

    try {
        // Récupération des données
        $invoiceIdentifier = $request->input('invoice_identifier');
        $cancelMotif = $request->input('cn_motif');
        $apiKey = $this->getValidApiKey(); // Méthode pour obtenir une clé API valide
        $baseUrl = 'https://ebms.obr.gov.bi:8443/ebms_api/';
        $url = $baseUrl . 'cancelInvoice/';

        // Appel API
        $response = Http::withToken($apiKey)
            ->acceptJson()
            ->post($url, [
                "invoice_identifier" => $invoiceIdentifier,
                "cn_motif" => $cancelMotif,
            ]);

        // Vérification de la réponse
        if ($response->successful()) {
            Log::info('Facture annulée avec succès', ['response' => $response->json()]);
            return response()->json([
                'success' => true,
                'message' => 'Facture annulée avec succès.',
                'data' => $response->json(),
            ]);
        }

        // Gestion des erreurs
        Log::warning('Erreur lors de l\'annulation de la facture', [
            'status' => $response->status(),
            'body' => $response->body(),
        ]);

        return response()->json([
            'success' => false,
            'message' => $response->json()['msg'] ?? 'Une erreur est survenue.',
            'status_code' => $response->status(),
        ]);

    } catch (\Exception $e) {
        Log::error('Erreur système lors de l\'annulation de la facture', [
            'message' => $e->getMessage(),
        ]);

        return response()->json([
            'success' => false,
            'message' => 'Erreur interne du serveur.',
            'status_code' => 500,
        ]);
    }
}
